<!--pages_my/applayNum/index.wxml-->
<view class="applayNum">
  <van-nav-bar custom-class="navbar" title="颜币充值" fixed z-index="{{99}}" border="{{false}}" left-arrow bind:click-left="onClickLeft">
  </van-nav-bar>
  <view class="content">
    <view class="bigBg">
      <image src="{{imgBaseURL?(imgBaseURL+'/images/4002x2.png'):''}}" mode="" />
    </view>
    <view class="con">
      <image class="bg" src="{{imgBaseURL?(imgBaseURL+'/images/511.svg'):''}}" mode="aspectFill" />
      <image class="ava" src="{{userInfo.avatar}}" mode="aspectFill" />
      <view class="name">{{userInfo.nickName}}</view>
      <view class="num">
        <image src="{{imgBaseURL?(imgBaseURL+'/images/16547.svg'):''}}" mode="" />
        <text>{{userInfo.balance||0}}</text>
      </view>
      <view class="str">颜币充值<van-icon bind:tap="showTipMsg" custom-class="ico" name="info-o" />
      </view>

    </view>
    <view class="nums">
      <view class="item {{act==index?'actItem':''}}" wx:for="{{userInfo.balancePriceVos}}" wx:key="index" data-index="{{index}}" bind:tap="select">
        <view class="one">
          <image src="{{imgBaseURL?(imgBaseURL+'/images/16547.svg'):''}}" mode="" />
          <text>{{item.num}}</text>
        </view>
        <view class="two">
          ￥{{item.price}}
        </view>
      </view>
    </view>

<view class="jl" bind:tap="goPage" data-path="/pages_my/recharge_list/index">
  颜币明细<van-icon name="arrow" />
</view>

    <view class="tip">
      <view class="l1">本平台唯一付费项目，感谢捐赠!</view>
      <view class="l2">点击购买即同意《<text data-path="/pages_my/privacyAgreement/index" bind:tap="goPage">隐私政策</text>》《<text data-path="/pages_my/userAgreement/index" bind:tap="goPage">服务协议</text>》</view>
    </view>
  </view>


  <my-fotter-btn bind:btnTap="submit">立即充值</my-fotter-btn>

  <van-dialog use-slot title="颜币规则" show="{{ showTip }}" confirm-button-color="#6E95E1">
    <view class="vandialogtip">
      <view class="fw">颜币用途</view>
      <view class="indent"> 颜币可用于平台中付费项目抵扣，解锁用户微信，主动私聊用户</view>
      <view class="fw">获取途径</view>
      <view class="indent">用户可进行充值来获取颜币</view>
      <view class="fw">颜币退款</view>
      <view class="indent">如果用户解锁他人微信被拒绝，所消耗的颜币将原路返回，退回的颜币可继续用于平台消费</view>
    </view>
  </van-dialog>
  <my-message wx:if="{{showMsg}}" openType="contact" title="提示" message="由于苹果相关规范，iOS暂不支持此功能!" btnStr="联系客服" bind:onClose="onClose"></my-message>
  <my-http-message class="httpMessage"></my-http-message>
</view>