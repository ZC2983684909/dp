<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wxmblog.yanjian.dao.DistributionAmountDao">

    <!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.wxmblog.yanjian.entity.DistributionAmountEntity" id="distributionAmountMap">
        <result property="id" column="id"/>
        <result property="creator" column="creator"/>
        <result property="createTime" column="create_time"/>
        <result property="modifyer" column="modifyer"/>
        <result property="modifyTime" column="modify_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="version" column="version"/>
        <result property="userId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="amount" column="amount"/>
        <result property="payUserId" column="pay_user_id"/>
        <result property="orderId" column="order_id"/>
        <result property="body" column="body"/>
        <result property="reason" column="reason"/>
    </resultMap>

    <select id="distributionAmountPage"
            parameterType="com.wxmblog.yanjian.common.rest.request.front.distribution.DistributionAmountRequest"
            resultType="com.wxmblog.yanjian.common.rest.response.front.distribution.DistributionAmountResponse">
        select da.id, tu.avatar, da.create_time, da.amount, uao.amount as payAmount, da.body, da.reason
        from distribution_amount da
        left join t_user tu on da.pay_user_id = tu.id
        left join user_apply_order uao on da.order_id = uao.id
        <where>
            da.del_flag = 0
            and uao.`status` = 2
            and uao.del_flag = 0
            and da.type = 1
            and da.user_id = #{ownerId}
        </where>
        order by da.create_time desc, da.id desc
    </select>

    <select id="withdrawRecordPage"
            parameterType="string"
            resultType="com.wxmblog.yanjian.common.rest.response.front.distribution.WithdrawRecordResponse">
        select da.id, da.create_time, abs(da.amount) as amount
        from distribution_amount da
        where da.del_flag = 0
          and da.type = 2
          and da.user_id = #{ownerId}
        order by da.create_time desc, da.id desc
    </select>
</mapper>