<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.wxmblog.yanjian.dao.UserShieldDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.wxmblog.yanjian.entity.UserShieldEntity" id="userShieldMap">
        <result property="id" column="id"/>
        <result property="creator" column="creator"/>
        <result property="createTime" column="create_time"/>
        <result property="modifyer" column="modifyer"/>
        <result property="modifyTime" column="modify_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="version" column="version"/>
        <result property="userId" column="user_id"/>
        <result property="shieldId" column="shield_id"/>
    </resultMap>


    <resultMap id="userPageResponse"
               type="com.wxmblog.yanjian.common.rest.response.front.user.UserInfoPageResponse">
        <result property="personalPhoto" column="personal_photo"
                typeHandler="com.wxmblog.yanjian.common.handle.PhotoListHandler"/>
    </resultMap>

    <select id="getPage" resultMap="userPageResponse"
            parameterType="com.wxmblog.yanjian.common.rest.request.front.star.UserStarRequest">
        select t.id,
        t.avatar,
        t.nick_name,
        t.sex,
        t.city,
        t.county,
        t.main_city,
        t.birth_date,
        t.birth_date as birthFormatDate,
        t.height,
        t.weight,
        t.job_mes,
        t.personal_photo,
        t.id_auth,
        t.edu_auth
        from user_shield us
        left join t_user t on us.shield_id = t.id
        <where>
            us.del_flag = 0
            and t.del_flag = 0
            <if test="ownerId!=null and ownerId!=''">
                and us.user_id=#{ownerId}
            </if>
        </where>
        order by us.create_time desc

    </select>
</mapper>